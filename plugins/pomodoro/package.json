{
  "name": "com.jimcast.plugins.pomodoro",
  "version": "0.1.0",
  "private": true,
  "description": "Pomodoro timer for jimcast: focus / break countdown, progress bar, notifications, with CLI.",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "jimcast": {
    "capabilities": [
      "shell",
      "widget-cli",
      "widget-keys"
    ]
  },
  "devDependencies": {
    "@jimcast/protocol": "github:irmansyah/jimcast_sdk#path:/packages/protocol",
    "@jimcast/sdk": "github:irmansyah/jimcast_sdk#path:/packages/sdk",
    "@types/node": "^22.0.0",
    "tsdown": ">=0.15.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
