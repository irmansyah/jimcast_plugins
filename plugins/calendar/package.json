{
  "name": "com.jimcast.plugins.calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Five-day calendar strip with today's tasks for jimcast, with CLI.",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "jimcast": {
    "capabilities": [
      "shell",
      "widget-cli"
    ]
  },
  "devDependencies": {
    "@jimcast/protocol": "^0.1.0",
    "@jimcast/sdk": "^0.1.0",
    "@types/node": "^22.0.0",
    "tsdown": ">=0.15.0",
    "typescript": "^5.6.0"
  }
}
