{
  "name": "jimcast-react-file-manager",
  "displayName": "FILE EXPLORER",
  "version": "1.0.0",
  "entry": "dist/index.html",
  "capabilities": ["shell", "fs:read", "search", "index"],

  "contributes": {
    "config": {
      "keyMode": { "type": "enum", "values": ["normal", "vim"], "default": "normal" }
    },

    "keybindings": {
      "moveUp":           ["ArrowUp"],
      "moveDown":         ["ArrowDown"],
      "moveLeft":         ["ArrowLeft"],
      "moveRight":        ["ArrowRight"],
      "activate":         ["Enter"],
      "toggleSelection":  ["Space"],
      "selectAll":        ["mod+a"],
      "copyPaths":        ["mod+c"],
      "deleteSelection":  ["d"],
      "renameSelection":  ["m"],
      "shellOnSelection": ["!"],
      "toggleHidden":     ["H"],
      "openCommandLine":  [":"]
    },

    "keybindingLayers": {
      "vim": {
        "moveUp":    ["k"],
        "moveDown":  ["j"],
        "moveLeft":  ["h"],
        "vimRight":  ["l"]
      },
      "confirm-delete": {
        "confirmDelete": ["d", "y"],
        "cancelConfirm": ["Escape"]
      }
    },

    "commandLine": {
      "up":   { "description": "Go up one level" },
      "home": { "description": "Jump to home" },
      "open": {
        "aliases": ["o"],
        "description": "Open entries by name, # or path",
        "args": [{ "name": "targets", "type": "entryOrPath", "variadic": true }]
      },
      "select":          { "aliases": ["s"], "args": [{ "name": "target", "type": "entry" }] },
      "select-all":      { "aliases": ["sa"] },
      "select-match":    { "aliases": ["sm"], "args": [{ "name": "pattern", "type": "glob" }] },
      "selected":        { "aliases": ["ls-sel"] },
      "clear-selection": { "aliases": ["cs"] },
      "copy":            { "aliases": ["cp"] },
      "delete": { "aliases": ["d"], "args": [{ "name": "target", "type": "entry", "required": false }] },
      "rename": {
        "aliases": ["r"], "split": "::", "pending": "Renaming…",
        "args": [{ "name": "target", "type": "entry" }, { "name": "newName", "type": "string" }]
      },
      "run": { "pending": "Running…", "args": [{ "name": "cmd", "type": "string", "greedy": true }] },
      "toggle-hidden": { "aliases": ["th"] },
      "list":          { "aliases": ["commands", "?"], "description": "Show all commands" }
    },

    "host": {
      "commands": {
        "list": {
          "description": "List a directory (default ~)",
          "args": [{ "name": "path", "type": "path", "required": false, "greedy": true }]
        },
        "home":     { "description": "List the home directory" },
        "selected": { "description": "List the files currently selected in the UI" }
      },
      "search": "search",
      "corpus": "corpus"
    }
  }
}
