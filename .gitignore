/target/
**/target/

# Remove Cargo.lock from git only if you're building a library;
# for applications, it's often recommended to keep it.
# Cargo.lock

# Rust build artifacts
*.rs.bk
*.rlib
*.prof
*.dwp
*.dSYM.zip
*.dSYM

# IDE and autogenerated Rust files
.rustfmt.log
.cargo-ok
.cargo/config.toml.local

# ──────────────────────────────────────────────────────────────
# Node.js / npm / Yarn / pnpm
# ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# npm lockfiles (consider committing for apps, ignoring for libs)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Build outputs
dist/
/dist/
*/dist/
**/dist/
/build/
/out/
/.next/
/.nuxt/
/.output/
/storybook-static/

# TypeScript compiled output
*.js
*.js.map
*.d.ts
**/tsconfig.tsbuildinfo

# Environment & config
.env
.env.local
.env.*.local
.env.production
.env.development

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

