{
  "api": {
    "base_url": "http://127.0.0.1:8080"
  },
  "theme": {
    "text_primary": "#FFFFFF",
    "text_muted": "#8A8A99",
    "project_status": {
      "planning": "#B496FF",
      "active": "#58C78A",
