{
  "name": "jimcast-external-emoji-picker",
  "version": "0.1.0",
  "private": true,
  "description": "Emoji picker for jimcast: category tabs, Recent, click to copy, with CLI.",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "jimcast": {
    "capabilities": ["shell", "widget-cli"]
  },
  "dependencies": {
    "@jimcast/protocol": "file:../../jimcast-sdk/packages/protocol",
    "@jimcast/sdk": "file:../../jimcast-sdk/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": ">=0.15.0",
    "typescript": "^5.6.0"
  }
}
